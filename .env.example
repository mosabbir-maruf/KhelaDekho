# ===========================================
# KhelaDekho Frontend (Next.js) Configuration
# ===========================================

# --- Backend API ---
# URL pointing to your deployed Cloudflare Worker
KHELADEKHO_API_URL=https://your-api.workers.dev

# --- Backend API Key ---
# Required for all backend API requests (injected server-side via layout)
# Must match XKEY in KhelaDekho-API/.env.example
# Generate one: openssl rand -hex 32 (or any random string)
# Set via Cloudflare Pages Dashboard or `wrangler pages secret put XKEY` (not in wrangler.toml)
XKEY=your-xkey-here

# --- Client-Side API Override (Optional) ---
NEXT_PUBLIC_API_URL=

# --- Telegram Contact Form ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# --- GitHub Integration (Optional) ---
GITHUB_TOKEN=

# --- Google Analytics 4 (Optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- TheSportsDB API (Football Matches) ---
NEXT_PUBLIC_SPORTSDB_API_KEY=your-api-key-here
