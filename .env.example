# ===========================================
# KhelaDekho Frontend (Next.js) Configuration
# ===========================================

# --- Backend API ---
# URL of your deployed API (Cloudflare Worker or FastAPI)
KHELADEKHO_API_URL=https://your-api.workers.dev

# --- Backend API Key (single shared key) ---
# Required for all backend API requests (injected server-side via layout).
# Must match XKEY in KhelaDekho-API. Generate: openssl rand -hex 32
# Set via Cloudflare Pages Dashboard or `wrangler pages secret put XKEY`.
XKEY=your-xkey-here

# --- Client-Side API Override (optional) ---
NEXT_PUBLIC_API_URL=

# --- Telegram Contact Form ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# --- GitHub Integration (optional; higher rate limit for repo stars) ---
GITHUB_TOKEN=

# --- Google Analytics 4 (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Admin Portal ---
# Secret key to unlock the dashboard. Generate: openssl rand -hex 32
# Set via Cloudflare Pages Environment Variables (do not commit).
ADMIN_SECRET_KEY=your-admin-secret-key-here
